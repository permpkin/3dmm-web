# Copy to .env (gitignored) for local dev; CI reads these from repo vars/secrets.
# All optional — the app builds and runs with none set (Sentry fully disabled).

# Runtime error reporting — client key DSN from
# Sentry > Settings > Projects > <project> > Client Keys (DSN)
VITE_SENTRY_DSN=

# Usage analytics — GA4 Measurement ID (G-XXXXXXXXXX) from
# Google Analytics > Admin > Data Streams > <stream>
VITE_GA_MEASUREMENT_ID=

# Sourcemap upload on build — put these in .env.sentry-build-plugin instead,
# which the vite plugin reads (also gitignored). Org auth token from
# Sentry > Settings > Auth Tokens
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
